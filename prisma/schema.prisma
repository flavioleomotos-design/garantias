datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tab {
  id            String   @id @default(uuid())
  name          String   @unique
  columns       String[] 
  hiddenColumns String[] 
  customColumns String[] 
  rows          Json     
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}